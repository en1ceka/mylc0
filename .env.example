# Copy to .env and fill in. .env is gitignored and must stay that way.
# Cloudflare dashboard: R2 -> Manage API Tokens -> Create Account API Token
# (Object Read & Write on the bucket). The S3 client needs only these four;
# the "cfat_..." token value is for the Cloudflare REST API and is NOT used here.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_BUCKET=mylc0
R2_REGION=auto
